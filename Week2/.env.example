# Week 2 — Agentic Deep Dive (repo root only)
# Copy to .env and fill in the Anthropic values before Day 1.
#   copy .env.example .env      # Windows
#   cp .env.example .env        # macOS / Linux
# Never commit .env — it is in .gitignore.
#
# Anthropic is the primary Week 2 provider. Later provider-routing sessions introduce
# genuine Bedrock, Gemini, and Azure integrations without duplicating the curriculum.

# ── Primary provider (required before Day 1 AM) ──
LLM_PROVIDER=anthropic

# ── Domain lane (one per learner for the week) ──
AGENT_LANE=insurance
# Options:
#   insurance  → claims triage / FNOL / policy tools (data/insurance/)
#   banking    → loan / KYC / permission-aware retrieval (data/banking/)
#   logistics  → control-tower / shipment / delay tools (data/logistics/)

# ── Anthropic (required) ──
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-6
# Common ANTHROPIC_MODEL options (trainer may restrict):
#   claude-sonnet-4-6   — default; speed + cost balance for labs
#   claude-opus-4-8     — deeper reasoning; higher cost (demo / complex flows only)

# ── Day 2 required primer: Google ADK + Gemini API ──
# Create a key at https://aistudio.google.com/app/apikey
GOOGLE_API_KEY=
GOOGLE_ADK_MODEL=gemini-2.5-flash
# This primer uses Google AI Studio, not Vertex AI.
GOOGLE_GENAI_USE_VERTEXAI=FALSE

# ── Day 2 required primer: Microsoft Agent Framework + Foundry ──
# For shared-key authentication, copy the OpenAI-compatible v1 endpoint shown
# with the Project API key in Foundry, plus that key and the deployment name.
# Both endpoint forms are accepted (keep the trailing /openai/v1/):
#   https://<resource>.services.ai.azure.com/api/projects/<project>/openai/v1/
#   https://<resource>.openai.azure.com/openai/v1/
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_BASE_URL=https://<resource>.services.ai.azure.com/api/projects/<project>/openai/v1/
FOUNDRY_MODEL=
# FOUNDRY_MODEL must be the deployment name, which may differ from gpt-5-mini.
# The shared training key must be rotated after the cohort and never committed.

# ── Day 3 classroom-tested primary vector store: Pinecone ──
# Create a project and API key at https://app.pinecone.io/
PINECONE_API_KEY=
PINECONE_INDEX=exl-week2-policy
PINECONE_NAMESPACE=policy-corpus-v1
PINECONE_CLOUD=aws
PINECONE_REGION=us-east-1
PINECONE_METRIC=cosine
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
EMBEDDING_DIMENSION=384
MIN_RETRIEVAL_SCORE=0.70
# Day 3 creates the 384-dimensional cosine index when absent. A namespace is
# created implicitly on the first upsert; it is not provisioned separately.

# ── Day 3 implemented alternative: PostgreSQL + pgvector (runtime test deferred) ──
# Use the Day 3 setup guide to start the local pgvector container, or provide
# an equivalent managed PostgreSQL connection with the vector extension enabled.
PGVECTOR_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/exl_week2
PGVECTOR_SCHEMA=public
PGVECTOR_TABLE=policy_chunks
PGVECTOR_INDEX=policy_chunks_embedding_hnsw
# Replace the example local credentials for shared or managed environments.
# Never commit real database passwords.

# ── LangSmith (required Days 4–5 — tracing + trajectory evals) ──
LANGCHAIN_TRACING_V2=true
# Options: true | false  (set false only if trainer disables tracing)
LANGCHAIN_API_KEY=
LANGCHAIN_PROJECT=exl-week2
# LANGCHAIN_PROJECT — any string; keep cohort on same project name for shared dashboards

# ── MLflow (Day 4+ eval runs) ──
# mlflow ui does NOT read .env automatically — use:
#   uv run --env-file .env mlflow ui --backend-store-uri W2D4/data/mlruns
MLFLOW_ALLOW_FILE_STORE=true
# Options: true | false  (true required for local ./mlruns store in Week 2 labs)

# ── Optional: agent runtime guardrails ──
AGENT_MAX_STEPS=10
# Suggested range: 5–20  (labs default 10; lower = cheaper, higher = more tool turns)
AGENT_MAX_TOKENS=8000
# LangGraph ChatAnthropic per-call output cap. Claude Agent SDK does not expose a
# general run-level max_tokens option; use max turns and max budget for SDK runs.
AGENT_MAX_BUDGET_USD=0.50
# Claude Agent SDK client-estimated run cap, checked between turns.
AGENT_REQUEST_TIMEOUT_SECONDS=60
# Outer application timeout for live model and SDK requests.
SDK_WORKER_TIMEOUT_SECONDS=120
# Multi-turn Claude Agent SDK subagent timeout; includes delegation and tool turns.
AGENT_THINKING_TOKENS=0
# 0 disables extended thinking. Try 2000 only for a guided comparison.

# ── Day 3 implemented alternative: local Chroma (runtime test deferred) ──
# Uses EMBEDDING_MODEL and EMBEDDING_DIMENSION from the Pinecone section.
CHROMA_PERSIST_DIR=data/chroma_persist
CHROMA_COLLECTION=policy-corpus-v1
# Options (relative to repo root):
#   data/chroma_persist              — default local fallback index
#   data/chroma_persist_insurance    — lane-specific rebuild (Day 3+)
#   data/chroma_persist_banking
#   data/chroma_persist_logistics
#   W2D3/W2D3PM/data/chroma_persist  — per-session folder if scaffold uses day folders

# ── Optional: dataset root ──
# DATA_DIR=data
# Options:
#   data                    — default monorepo layout (recommended)
#   ../Week1/data           — symlink / reuse Week 1 assets without copying

# ── Optional: local Chroma rebuild behaviour (Day 3+) ──
# REBUILD_INDEX=false
# Options:
#   false — load an existing local fallback index (faster; default)
#   true  — re-ingest lane corpora on startup (slower; use when trainer asks)

# ── Optional: MCP transport (Day 2+) ──
# MCP_TRANSPORT=stdio
# Options:
#   stdio  — default; agent spawns MCP server as subprocess
#   http   — separate terminal runs mcp_servers/*.py (check session README for port)

# ── Optional: logging / debug ──
# LOG_LEVEL=INFO
# Options: DEBUG | INFO | WARNING | ERROR

# Day 4+ — Presidio PII guardrails use spaCy; download once after pip install:
#   uv run python -m spacy download en_core_web_sm
